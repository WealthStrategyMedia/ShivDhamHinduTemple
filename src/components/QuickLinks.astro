---
// The quick-navigation icon strip the live site shows right under its
// homepage hero (Puja Booking / About Us / Canteen / Volunteering /
// Gallery / Activity), so first-time visitors can jump straight to the
// pages they're most likely to want without hunting through the nav.
const LINKS = [
  {
    href: '/puja-bookings/',
    title: 'Puja Booking',
    description: 'Book a Divine Puja Now.',
    icon: 'lotus',
  },
  {
    href: '/about-us/',
    title: 'About Us',
    description: 'Explore Our Sacred Temple.',
    icon: 'temple',
  },
  {
    href: '/canteen/',
    title: 'Canteen',
    description: 'Savor Our Sacred Canteen.',
    icon: 'bowl',
  },
  {
    href: '/volunteering/',
    title: 'Volunteering',
    description: 'Share Your Sacred Time.',
    icon: 'heart-hand',
  },
  {
    href: '/gallery/',
    title: 'Gallery',
    description: 'View Our Sacred Moments.',
    icon: 'gallery',
  },
  {
    href: '/events/',
    title: 'Events',
    description: 'Join Our Sacred Celebrations.',
    icon: 'calendar',
  },
] as const;
---

<section class="border-b border-ivory-200 bg-white">
  <div class="container-page py-14 sm:py-16">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6 lg:gap-x-4">
      {LINKS.map((item) => (
        <a href={item.href} class="quicklink group flex flex-col items-center text-center">
          <span class="flex h-14 w-14 items-center justify-center text-marigold-500 transition-colors group-hover:text-maroon-700">
            {item.icon === 'lotus' && (
              <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21c-4-1-6-4-6-8 3 0 5 1.5 6 4 1-2.5 3-4 6-4 0 4-2 7-6 8Z" />
                <path d="M12 13c0-4 1.5-7 4-9-1 4-1 7-4 9Z" />
                <path d="M12 13c0-4-1.5-7-4-9 1 4 1 7 4 9Z" />
                <path d="M12 13V3" />
              </svg>
            )}
            {item.icon === 'temple' && (
              <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="2.6" r="0.7" fill="currentColor" stroke="none" />
                <path d="M12 3.3v1.8" />
                <path d="M4 11 12 5l8 6" />
                <path d="M5.5 11V20h13v-9" />
                <path d="M9.5 20v-5a2.5 2.5 0 0 1 5 0v5" />
                <path d="M3 20h18" />
              </svg>
            )}
            {item.icon === 'bowl' && (
              <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12h16a8 8 0 0 1-16 0Z" />
                <path d="M2 12h20" />
                <path d="M9.5 8c-.6-.9-.6-1.7 0-2.6" />
                <path d="M12.5 8c-.6-.9-.6-1.7 0-2.6" />
                <path d="M15.5 8c-.6-.9-.6-1.7 0-2.6" />
              </svg>
            )}
            {item.icon === 'heart-hand' && (
              <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 13.5s-3.6-2.3-3.6-5A2.4 2.4 0 0 1 12 7a2.4 2.4 0 0 1 3.6 1.5c0 2.7-3.6 5-3.6 5Z" />
                <path d="M4 16c1.6-1.3 3.3-1.3 5 0l2 1.5c1 .8 2 .8 3 0l2-1.5c1.7-1.3 3.4-1.3 5 0" />
                <path d="M4 20c1.6-1.3 3.3-1.3 5 0" />
                <path d="M15 20c1.6-1.3 3.3-1.3 5 0" />
              </svg>
            )}
            {item.icon === 'gallery' && (
              <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="7" y="3.5" width="13" height="13" rx="1.3" />
                <circle cx="10.3" cy="7" r="1" fill="currentColor" stroke="none" />
                <path d="M7 13.5 10 10l2.5 2.5 2-2 2.5 3" />
                <rect x="4" y="7.5" width="13" height="13" rx="1.3" fill="white" />
                <circle cx="7.3" cy="11" r="1" fill="currentColor" stroke="none" />
                <path d="M4 17.5 7 14l2.5 2.5 2-2 2.5 3" />
              </svg>
            )}
            {item.icon === 'calendar' && (
              <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3.5" y="5" width="17" height="16" rx="2" />
                <path d="M8 3v4M16 3v4M3.5 10h17" />
                <circle cx="8" cy="14" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="12" cy="14" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="16" cy="14" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="8" cy="17.5" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="12" cy="17.5" r="0.9" fill="currentColor" stroke="none" />
              </svg>
            )}
          </span>
          <h3 class="mt-3 font-display text-lg font-semibold text-maroon-800">{item.title}</h3>
          <p class="mt-1 text-sm font-medium text-marigold-600">{item.description}</p>
          <span class="mt-4 flex h-9 w-9 items-center justify-center rounded-full border border-marigold-300 text-marigold-500 transition-colors group-hover:border-maroon-700 group-hover:bg-maroon-700 group-hover:text-white">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
