---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Mandala from './Mandala.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Where the important part of the photo sits, for a tall crop on mobile. */
  focus?: 'center' | 'top' | 'bottom' | 'left' | 'right';
  compact?: boolean;
}

const { eyebrow, title, description, image, imageAlt = '', focus = 'center', compact = false } = Astro.props;
const focusClass = {
  center: 'object-center',
  top: 'object-top',
  bottom: 'object-bottom',
  left: 'object-left',
  right: 'object-right',
}[focus];
---

<!--
  A `<div>`, not `<header>` — the site already has one page-level banner
  landmark (the nav in Header.astro). A second top-level `<header>` here
  would register as a duplicate "banner" landmark for screen readers.
-->
{image ? (
  <div class:list={[compact ? 'hero-photo-compact' : 'hero-photo', 'flex items-end']}>
    <Image src={image} alt={imageAlt} width={1920} height={compact ? 640 : 900} widths={[640, 960, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class:list={['', focusClass]} />
    <div class="hero-content container-page w-full py-12 sm:py-16 lg:py-20">
      {eyebrow && <p class="eyebrow text-marigold-300">{eyebrow}</p>}
      <h1 class="mt-2 text-white">{title}</h1>
      {description && <p class="mt-4 max-w-2xl text-lg text-ivory-100">{description}</p>}
      <slot />
    </div>
  </div>
) : (
  <div class="hero-pattern flex items-end">
    <Mandala class="mandala-decor" />
    <div class="hero-content container-page w-full py-12 sm:py-16 lg:py-20">
      {eyebrow && <p class="eyebrow text-marigold-300">{eyebrow}</p>}
      <h1 class="mt-2 text-white">{title}</h1>
      {description && <p class="mt-4 max-w-2xl text-lg text-ivory-100">{description}</p>}
      <slot />
    </div>
  </div>
)}
