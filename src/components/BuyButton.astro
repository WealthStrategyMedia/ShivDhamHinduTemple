---
// Reusable "pay now" button for anything with a fixed price: store items,
// program registration fees, puja bookings. Posts to the same
// create-checkout-session function DonationForm uses, so it activates the
// moment STRIPE_SECRET_KEY is set in Netlify — no code changes needed.
interface Props {
  /** Dollar amount, e.g. 45 for $45.00. */
  amount: number;
  /** Shown on the Stripe Checkout page and in the temple's Stripe dashboard. */
  description: string;
  label?: string;
  class?: string;
  /** Optional Stripe Price ID — once real products exist in Stripe, set this
      and the button switches from an ad-hoc amount to that priced item. */
  stripePriceId?: string;
  metadata?: Record<string, string>;
}

const {
  amount,
  description,
  label = `Pay $${amount}`,
  class: className = 'btn-primary w-full',
  stripePriceId,
  metadata = {},
} = Astro.props;
---

<button
  type="button"
  class:list={['buy-button', className]}
  data-amount={Math.round(amount * 100)}
  data-description={description}
  data-price-id={stripePriceId ?? ''}
  data-metadata={JSON.stringify(metadata)}
>
  {label}
</button>
<p class="buy-button-status mt-2 text-center text-xs text-ivory-500" role="status" aria-live="polite"></p>

<script>
  document.querySelectorAll<HTMLButtonElement>('.buy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const status = button.nextElementSibling as HTMLElement | null;
      const amount = Number(button.dataset.amount);
      const description = button.dataset.description ?? 'Purchase';
      const priceId = button.dataset.priceId;
      let metadata: Record<string, string> = {};
      try { metadata = JSON.parse(button.dataset.metadata ?? '{}'); } catch {}

      button.disabled = true;
      if (status) { status.textContent = 'Starting checkout…'; status.className = 'buy-button-status mt-2 text-center text-xs text-ivory-500'; }

      try {
        const res = await fetch('/.netlify/functions/create-checkout-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: 'payment',
            ...(priceId
              ? { lineItems: [{ price: priceId, quantity: 1 }] }
              : { amount, currency: 'usd', description }),
            metadata,
            successPath: '/order-confirmation/',
            cancelPath: '/order-failed/',
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error ?? 'Checkout failed');
        window.location.href = data.url;
      } catch (err) {
        if (status) {
          status.textContent =
            err instanceof Error && err.message.includes('not enabled')
              ? "Online payment isn't enabled yet — please contact the temple office to complete this."
              : 'Something went wrong starting checkout. Please try again or contact the temple office.';
          status.className = 'buy-button-status mt-2 text-center text-xs text-maroon-600';
        }
        button.disabled = false;
      }
    });
  });
</script>
