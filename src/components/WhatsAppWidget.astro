---
// Floating WhatsApp chat widget, present on every page via BaseLayout —
// mirrors the widget on the temple's current live site: a round WhatsApp
// button that expands into a greeting card with a link into a chat
// pre-filled with an introductory message.
const WHATSAPP_URL =
  "https://wa.me/14077795128?text=Namaste%20%F0%9F%99%8F%20I%27d%20like%20to%20know%20more%20about%20Shri%20Shiv%20Dham%20Hindu%20Temple%2C%20Orlando%20and%20its%20activities.%20Thank%20you%20%F0%9F%99%8F";
---

<div id="whatsapp-widget" class="fixed bottom-5 right-5 z-40 flex flex-col items-end gap-3">
  <div
    id="whatsapp-card"
    class="hidden w-72 origin-bottom-right overflow-hidden rounded-2xl bg-white shadow-lift transition"
    role="dialog"
    aria-label="Chat with the temple on WhatsApp"
  >
    <div class="flex items-center justify-between bg-[#25D366] px-4 py-3">
      <div class="flex items-center gap-2 text-white">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.5A10 10 0 1 0 12 2m0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .9.9-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2m4.5-6.1c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-1.4-.7-2.3-1.2-3.2-2.7-.2-.3 0-.5.2-.7.2-.2.4-.5.6-.7.1-.2.1-.4 0-.5-.1-.2-.5-1.4-.7-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.1 0 1.3 1 2.5 1.1 2.7.1.2 1.8 2.8 4.4 3.8 2.1.9 2.5.7 3 .6.4-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.3-.2-.5-.3Z" /></svg>
        <span class="font-display text-sm font-semibold">WhatsApp</span>
      </div>
      <button id="whatsapp-close" type="button" aria-label="Close" class="flex h-6 w-6 items-center justify-center rounded-full bg-black/15 text-white hover:bg-black/25">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>

    <div class="px-4 py-4">
      <div class="rounded-2xl rounded-tl-sm bg-ivory-100 px-3.5 py-3 text-sm leading-relaxed text-ivory-800">
        Jai Shree Krishna! 🌸<br />
        For darshan, aarti timings, temple updates, or any queries, tap the button below to start chatting! 💬✨
      </div>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        class="mt-3 flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] py-2.5 text-sm font-semibold text-white transition hover:bg-[#20b858]"
      >
        Open chat
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>

  <button
    id="whatsapp-toggle"
    type="button"
    aria-label="Chat with the temple on WhatsApp"
    aria-expanded="false"
    class="flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lift transition hover:bg-[#20b858] hover:scale-105"
  >
    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.5A10 10 0 1 0 12 2m0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .9.9-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2m4.5-6.1c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-1.4-.7-2.3-1.2-3.2-2.7-.2-.3 0-.5.2-.7.2-.2.4-.5.6-.7.1-.2.1-.4 0-.5-.1-.2-.5-1.4-.7-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.1 0 1.3 1 2.5 1.1 2.7.1.2 1.8 2.8 4.4 3.8 2.1.9 2.5.7 3 .6.4-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.3-.2-.5-.3Z" /></svg>
  </button>
</div>

<script>
  const card = document.getElementById('whatsapp-card');
  const toggleBtn = document.getElementById('whatsapp-toggle');
  const closeBtn = document.getElementById('whatsapp-close');

  function setOpen(open: boolean) {
    card?.classList.toggle('hidden', !open);
    toggleBtn?.setAttribute('aria-expanded', String(open));
  }

  toggleBtn?.addEventListener('click', () => setOpen(card?.classList.contains('hidden') ?? true));
  closeBtn?.addEventListener('click', () => setOpen(false));

  // Greet visitors with the open card once per browser session, same as
  // the widget on the temple's live site, without re-popping on every
  // page navigation within that session.
  try {
    if (!sessionStorage.getItem('whatsapp-widget-greeted')) {
      setTimeout(() => setOpen(true), 1500);
      sessionStorage.setItem('whatsapp-widget-greeted', '1');
    }
  } catch {}
</script>
