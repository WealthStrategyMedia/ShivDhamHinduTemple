---
// Responsive YouTube embed — `orientation="portrait"` for Shorts (9:16),
// the default "landscape" for standard 16:9 video.
//
// Click-to-play: the page shows a poster image and only loads YouTube's player
// (well over a megabyte of scripts) when the visitor presses play, so pages with
// videos stay fast. Posters are served from this site (public/video-posters/,
// made with `node scripts/video-poster.mjs <id> [--portrait]`) so they appear
// instantly and never depend on YouTube's servers. If a poster is missing the
// script falls back to YouTube's thumbnail, and finally to a branded tile, so a
// video is never an empty black box. See lib/youtube-facade.ts.
import lqip from '../data/video-lqip.json';

interface Props {
  id: string;
  title: string;
  orientation?: 'landscape' | 'portrait';
  class?: string;
}
const { id, title, orientation = 'landscape', class: className = '' } = Astro.props;
const portrait = orientation === 'portrait';
// A ~350-character blurred copy of the poster, painted instantly as the background
// while the real poster loads (and kept if it ever fails to).
const preview = (lqip as Record<string, string>)[id];
---

<div
  class:list={[
    'yt-embed relative overflow-hidden rounded-2xl bg-gradient-to-br from-maroon-600 to-maroon-800 shadow-lift',
    portrait ? 'aspect-[9/16]' : 'aspect-video',
    className,
  ]}
  data-yt-id={id}
  data-yt-title={title}
  style={preview ? `background-image:url(${preview});background-size:cover;background-position:center` : undefined}
>
  {!preview && <span class="yt-fallback absolute inset-0 flex items-center justify-center font-display text-7xl text-marigold-200/60" aria-hidden="true">ॐ</span>}
  <button type="button" class="group absolute inset-0 block h-full w-full cursor-pointer" aria-label={`Play video: ${title}`}>
    <img
      src={`/video-posters/${id}.webp`}
      alt=""
      width={portrait ? 405 : 960}
      height={portrait ? 720 : 540}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
    />
    <span class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/5"></span>
    <span class="absolute inset-x-0 bottom-0 p-4 pr-5 text-left text-xs font-semibold leading-snug text-white [text-shadow:0_1px_3px_rgb(0_0_0/0.6)] sm:text-sm">
      <span class="line-clamp-2">{title}</span>
    </span>
    <span class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-marigold-500 text-maroon-800 shadow-lift ring-4 ring-white/40 transition group-hover:scale-110 group-hover:bg-marigold-400">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true" class="ml-1"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11.04-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14Z" /></svg>
    </span>
  </button>
  <noscript>
    <a href={`https://www.youtube.com/watch?v=${id}`} class="absolute inset-0 z-10 flex items-center justify-center p-6 text-center text-sm font-semibold text-white underline">Watch “{title}” on YouTube</a>
  </noscript>
</div>
