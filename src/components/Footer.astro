---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { SITE, FOOTER_LINKS } from '../lib/site';
import SocialIcons from './SocialIcons.astro';

const year = 2026;

const quickLinks = [
  { label: 'Temple Hub', href: '/temple-hub/' },
  { label: 'View Temple Services', href: '/puja-bookings/' },
  { label: 'Events Calendar', href: '/events/' },
  { label: 'Blog & News', href: '/blog/' },
  { label: 'Programs & Classes', href: '/programs/' },
  { label: 'Temple Store', href: '/temple-store/' },
  { label: 'Fundraising Goals', href: '/fundraising-goals/' },
  { label: 'Volunteer', href: '/volunteering/' },
  { label: 'Gallery', href: '/gallery/' },
];

const aboutLinks = [
  { label: 'About Us', href: '/about-us/' },
  { label: 'Mission & Vision', href: '/mission-and-vision/' },
  { label: "Guruji's Biography", href: '/guruji-biography/' },
  { label: 'Temple Staff', href: '/temple-staff/' },
  { label: 'Temple Facilities', href: '/temple-facilities/' },
  { label: 'FAQ', href: '/faq/' },
];
---

<footer class="mt-24 bg-maroon-800 text-ivory-100">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Image src={logo} alt={SITE.name} width={156} height={36} widths={[156, 312]} sizes="156px" format="webp" class="h-9 w-auto brightness-0 invert" />
      <p class="mt-4 text-sm leading-relaxed text-ivory-300">{SITE.tagline}</p>
      <p class="mt-4 text-sm text-ivory-300">{SITE.address.full}</p>
      <a href={SITE.phoneHref} class="mt-1 block text-sm text-ivory-300 hover:text-marigold-300">{SITE.phone}</a>
      <a href={`mailto:${SITE.email}`} class="text-sm text-ivory-300 hover:text-marigold-300">{SITE.email}</a>
      <SocialIcons size={17} iconClass="text-ivory-300 hover:text-marigold-300" gapClass="gap-4 mt-5" />
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-marigold-300">Quick Links</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {quickLinks.map((l) => (
          <li><a href={l.href} class="text-ivory-300 hover:text-ivory-50">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-marigold-300">About the Temple</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {aboutLinks.map((l) => (
          <li><a href={l.href} class="text-ivory-300 hover:text-ivory-50">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-marigold-300">Support the Temple</h3>
      <p class="mt-4 text-sm leading-relaxed text-ivory-300">
        Your generosity sustains daily worship, festivals, and community programs for Central Florida's Hindu community.
      </p>
      <a href="/online-donations/" class="btn-primary mt-4">Donate Now</a>
    </div>
  </div>

  <div class="border-t border-maroon-700">
    <div class="container-page flex flex-col items-center justify-between gap-3 py-5 text-xs text-ivory-400 sm:flex-row">
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <nav class="flex flex-wrap justify-center gap-x-5 gap-y-1" aria-label="Legal">
        {FOOTER_LINKS.map((l) => (
          <a href={l.href} class="hover:text-ivory-100">{l.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
