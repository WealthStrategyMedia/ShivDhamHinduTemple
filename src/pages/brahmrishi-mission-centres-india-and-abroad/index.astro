---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Mandala from '../../components/Mandala.astro';
import gurujiPortrait from '../../assets/photos/guruji-portrait.jpg';

const HEAD_OFFICE = [
  { name: 'Brahmrishi Ashram', place: 'Virat Nagar, Post C.R.P.F., Pinjore, Haryana 134104' },
  { name: 'International Brahmrishi Mission (Head Office)', place: 'Sector 19-A, Chandigarh' },
  { name: 'Metaphysical Science Research Institute', place: 'Sector 19-A, Chandigarh' },
  { name: 'Brahmrishi Yoga Training College', place: 'Sector 19-A, Chandigarh' },
  { name: 'Divine Radiance (monthly magazine)', place: 'Sector 19-A, Chandigarh' },
];

const INDIA_CENTERS = [
  { name: 'Brahmrishi Bawra Sr. Sec. School', place: 'Madhopuri, Goshala Road, Ludhiana, Punjab' },
  { name: 'Shri Shakti Peeth Brahmrishi Bawra Sr. Sec. School', place: 'Beantpura, Chandigarh Road, Ludhiana, Punjab' },
