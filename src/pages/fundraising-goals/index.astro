---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import GoalGrid from '../../components/GoalGrid.astro';
import { getGoalUrlMap } from '../../lib/fundraising';
import altarHero from '../../assets/photos/altar-durga-shiva-ganesh-diyas.jpg';

const urlMap = await getGoalUrlMap();
---

<BaseLayout title="Fundraising Goals" description="Special fundraising campaigns at Shri Shiv Dham Hindu Temple, live from the Temple Hub.">
  <PageHero
    eyebrow="Give"
    title="Fundraising Goals"
    description="The campaigns the temple is raising funds for right now, live from the Temple Hub. Learn about each one and contribute directly."
    image={altarHero}
    imageAlt="The temple altar, lit with diyas for worship"
  />

  <div class="container-page py-16 sm:py-20">
    <GoalGrid urlMap={urlMap} />

    <div class="mt-16 rounded-2xl bg-ivory-100 p-8 text-center">
      <p class="text-ivory-700">
        Prefer to give where it's needed most? Make a
        <a href="/online-donations/" class="font-semibold text-maroon-700 underline decoration-marigold-300 decoration-2 underline-offset-2">general donation</a>
        to support daily puja, priest care, festivals, and community programs.
      </p>
    </div>
  </div>
</BaseLayout>
