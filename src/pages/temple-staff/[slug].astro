---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mandala from '../../components/Mandala.astro';

export async function getStaticPaths() {
  const staff = await getCollection('staff');
  return staff.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);
---

<BaseLayout title={person.data.name} description={person.data.role}>
  <div class="hero-pattern">
    <Mandala class="mandala-decor" />
    <div class="container-page relative z-10 flex flex-col items-center gap-6 py-16 text-center sm:flex-row sm:text-left sm:py-20">
      {person.data.photo ? (
        <Image src={person.data.photo} alt={person.data.name} width={160} height={160} class="h-32 w-32 shrink-0 rounded-full object-cover ring-4 ring-white/20" />
      ) : (
        <div class="flex h-32 w-32 shrink-0 items-center justify-center rounded-full bg-white/10 text-4xl ring-4 ring-white/20">🙏</div>
      )}
      <div>
        <p class="eyebrow text-marigold-300">{person.data.role}</p>
        <h1 class="mt-1 text-white">{person.data.name}</h1>
        {person.data.languages.length > 0 && (
          <p class="mt-2 text-sm text-ivory-100">Speaks {person.data.languages.join(', ')}</p>
        )}
      </div>
    </div>
  </div>
  <article class="container-prose py-16 sm:py-20">
    <div class="prose-temple">
      <Content />
    </div>
  </article>
</BaseLayout>
