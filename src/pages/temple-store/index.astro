---
import { TWEEBLE } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import canteenHero from '../../assets/photos/canteen.jpg';
---

<BaseLayout feeds={[TWEEBLE.api.products]} title="Temple Store" description="Shop the Temple Store, live from the Temple Hub — order directly from this site.">
  <PageHero
    eyebrow="Store"
    title="Temple Store"
    description="Everything the temple sells, live from the Temple Hub. Order directly from this page — no Tweeble account needed — or complete it on the Temple Hub instead."
    image={canteenHero}
    imageAlt="The temple canteen, where festival meals are prepared"
  />

  <div class="container-page py-16 sm:py-20">
    <ProductGrid />
  </div>
</BaseLayout>
