---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BuyButton from '../../components/BuyButton.astro';
import canteenHero from '../../assets/photos/canteen.jpg';

const items = (await getCollection('store')).sort((a, b) => a.data.order - b.data.order);

// Other purchasable/registerable offerings that already live in the
// puja-bookings catalogue — cross-linked here so the store is a complete
// front door to everything the temple sells, without duplicating content.
const services = await getCollection('services');
const moreFromTemple = services
  .filter((s) => s.data.actionVerb === 'purchase' || s.data.actionVerb === 'register')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Temple Store" description="Order festival thalis, register a Shravan Mela vendor booth, and more from Shri Shiv Dham Hindu Temple.">
  <PageHero
    eyebrow="Store"
    title="Temple Store"
    description="Order festival thalis for pickup, reserve a vendor booth, and pick up a packet of Holi color — every purchase supports the temple's kitchen, festivals, and community programs."
    image={canteenHero}
    imageAlt="The temple canteen, where festival meals are prepared"
  />

  <div class="container-page py-16 sm:py-20">
    <section>
      <h2 class="text-maroon-700">Festival Thalis</h2>
      <p class="mt-2 max-w-xl text-sm text-ivory-600">Order ahead and pick up at the temple canteen. See the <a href="/canteen/" class="font-semibold text-maroon-700 underline decoration-marigold-300 decoration-2 underline-offset-2">Canteen page</a> for weekend hours.</p>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {items.map((item) => (
          <div class="card-photo flex flex-col">
            {item.data.image ? (
              <Image src={item.data.image} alt={item.data.title} width={480} height={320} class="h-56" />
            ) : (
              <div class="flex h-56 items-center justify-center bg-gradient-to-br from-maroon-600 to-maroon-800">
                <span class="font-display text-4xl text-marigold-200">ॐ</span>
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-lg font-semibold text-maroon-700">{item.data.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ivory-600">{item.data.summary}</p>
              <p class="mt-3 font-display text-xl font-semibold text-maroon-700">
                ${item.data.price.toFixed(2)}
                {item.data.unit && <span class="ml-1 text-xs font-normal text-ivory-500">{item.data.unit}</span>}
              </p>
              <div class="mt-4">
                <BuyButton
                  amount={item.data.price}
                  description={item.data.title}
                  label={`Order — $${item.data.price.toFixed(2)}`}
                  stripePriceId={item.data.stripePriceId}
                  metadata={{ item: item.data.title }}
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Products from the Temple Hub — stays hidden until at least one
         product exists on Tweeble, so an empty catalogue never shows. -->
    <section id="tweeble-products-section" class="mt-16 hidden">
      <div class="section-break mb-12">
        <span class="font-display text-xl text-marigold-500">✦</span>
      </div>
      <h2 class="text-maroon-700">From the Temple Hub</h2>
      <p class="mt-2 max-w-xl text-sm text-ivory-600">Additional products available directly from the temple, live from the Temple Hub.</p>
      <div id="tweeble-products-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"></div>
    </section>

    {moreFromTemple.length > 0 && (
      <section class="mt-16">
        <div class="section-break mb-12">
          <span class="font-display text-xl text-marigold-500">✦</span>
        </div>
        <h2 class="text-maroon-700">More From the Temple</h2>
        <p class="mt-2 max-w-xl text-sm text-ivory-600">Other items and registrations available through the temple, alongside its full range of <a href="/puja-bookings/" class="font-semibold text-maroon-700 underline decoration-marigold-300 decoration-2 underline-offset-2">puja bookings and services</a>.</p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {moreFromTemple.map((service) => (
            <a href={`/puja-bookings/${service.id}/`} class="card-photo group">
              {service.data.image ? (
                <Image src={service.data.image} alt={service.data.title} width={480} height={280} class="h-52" />
              ) : (
                <div class="flex h-52 items-center justify-center bg-gradient-to-br from-maroon-600 to-maroon-800">
                  <span class="font-display text-4xl text-marigold-200">ॐ</span>
                </div>
              )}
              <div class="p-6">
                <h3 class="font-display text-lg font-semibold text-maroon-700 group-hover:text-marigold-600">{service.data.title}</h3>
                <p class="mt-2 text-sm text-ivory-600 line-clamp-2">{service.data.summary}</p>
                <p class="mt-3 font-display text-lg font-semibold text-maroon-700">
                  {service.data.variants[0].price != null ? `$${service.data.variants[0].price}` : 'Contact us'}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<template id="tweeble-product-card-template">
  <a class="card-photo group" target="_blank" rel="noopener">
    <div class="relative h-52 overflow-hidden bg-gradient-to-br from-maroon-600 to-maroon-800">
      <img class="product-cover hidden h-52 w-full object-cover" loading="lazy" alt="" />
      <span class="product-fallback flex h-52 items-center justify-center font-display text-3xl text-marigold-200">ॐ</span>
    </div>
    <div class="p-6">
      <h3 class="product-name font-display text-base font-semibold text-maroon-700 group-hover:text-marigold-600"></h3>
      <p class="product-desc mt-2 text-sm text-ivory-600 line-clamp-2"></p>
      <div class="mt-3 flex items-center justify-between">
        <p class="product-price font-display text-lg font-semibold text-maroon-700"></p>
        <button type="button" class="share-trigger flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-ivory-400 hover:bg-ivory-100 hover:text-maroon-700" aria-label="Share this product">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 10.6 15.4 6.9M8.6 13.4l6.8 3.7" /></svg>
        </button>
      </div>
    </div>
  </a>
</template>

<script>
  import { fetchTweebleProducts, pick, formatCents, truncate, type TweebleProduct } from '../../lib/tweeble-client';
  import { initShareButtons } from '../../lib/share-widget';
  initShareButtons();

  (async () => {
    try {
      const products = await fetchTweebleProducts();
      if (!Array.isArray(products) || products.length === 0) return;

      const section = document.getElementById('tweeble-products-section');
      const grid = document.getElementById('tweeble-products-grid');
      const template = document.getElementById('tweeble-product-card-template') as HTMLTemplateElement | null;
      if (!section || !grid || !template) return;

      for (const product of products as TweebleProduct[]) {
        const node = template.content.cloneNode(true) as DocumentFragment;
        const name = pick<string>(product, ['name', 'title']) ?? 'Temple Product';
        const description = pick<string>(product, ['description', 'summary']) ?? '';
        const coverUrl = pick<string>(product, ['coverPhotoUrl', 'coverImageUrl', 'imageUrl']);
        const priceCents = pick<number>(product, ['priceCents', 'price']) ?? 0;
        const url = pick<string>(product, ['url', 'link']) ?? 'https://www.tweeble.com';

        const link = node.querySelector('a')!;
        link.href = url;

        const shareBtn = node.querySelector<HTMLElement>('.share-trigger')!;
        shareBtn.dataset.shareUrl = url;
        shareBtn.dataset.shareTitle = name;

        const img = node.querySelector<HTMLImageElement>('.product-cover')!;
        const fallback = node.querySelector<HTMLElement>('.product-fallback')!;
        if (coverUrl) {
          img.src = coverUrl;
          img.alt = name;
          img.classList.remove('hidden');
          fallback.classList.add('hidden');
        }

        node.querySelector('.product-name')!.textContent = name;
        node.querySelector('.product-desc')!.textContent = truncate(description, 100);
        node.querySelector('.product-price')!.textContent = formatCents(priceCents);

        grid.appendChild(node);
      }

      section.classList.remove('hidden');
    } catch (err) {
      // Fails silently — the store already has a full local catalogue, so
      // a Tweeble products outage shouldn't degrade this page for visitors.
      console.error('Failed to load Tweeble products', err);
    }
  })();
</script>
