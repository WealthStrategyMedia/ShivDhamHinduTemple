---
import { TWEEBLE } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import GoalGrid from '../../components/GoalGrid.astro';
import Mandala from '../../components/Mandala.astro';
import { getGoalUrlMap } from '../../lib/fundraising';
import heroImage from '../../assets/photos/congregation-puja.jpg';

const urlMap = await getGoalUrlMap();
---

<BaseLayout feeds={[TWEEBLE.api.fundraising]} title="Temple Projects" description="The temple's current building and improvement projects, and how the community can help see them through.">
  <PageHero
    eyebrow="Give"
    title="Temple Projects"
    description="The temple's current building and improvement projects, live from the Temple Hub. Every contribution, in any amount, helps carry them forward — and is tax deductible."
    image={heroImage}
    imageAlt="Devotees gathered for worship at the temple"
  />

  <div class="container-page py-16 sm:py-20">
    <GoalGrid urlMap={urlMap} />

    <div class="mt-16 hero-pattern relative overflow-hidden rounded-2xl">
      <Mandala class="mandala-decor" opacity={0.18} />
      <div class="relative z-10 flex flex-col items-center gap-5 px-6 py-14 text-center sm:py-16">
        <h2 class="max-w-xl text-white">Every Gift Moves This Forward</h2>
        <p class="max-w-lg text-ivory-100">
          Materials, labor, and the everyday costs of a project like this add up quickly. All contributions are tax deductible, and every gift, of any size, helps.
        </p>
        <a href="/online-donations/" class="btn-primary">Make a General Donation</a>
      </div>
    </div>
  </div>
</BaseLayout>
