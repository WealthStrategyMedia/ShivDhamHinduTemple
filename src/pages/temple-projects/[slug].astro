---
import { TWEEBLE } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mandala from '../../components/Mandala.astro';
import GoalGrid from '../../components/GoalGrid.astro';
import { getGoalPages, getGoalUrlMap } from '../../lib/fundraising';
import { descriptionToHtml, summaryFromDescription } from '../../lib/description';
import { formatGoalAmount } from '../../lib/tweeble-client';

export async function getStaticPaths() {
  const pages = await getGoalPages();
  return pages.map(({ slug, goal }) => ({ params: { slug }, props: { goal } }));
}

const { goal } = Astro.props;
const urlMap = await getGoalUrlMap();
const summary = summaryFromDescription(goal.description);
---

<BaseLayout feeds={[TWEEBLE.api.fundraising]} title={goal.title} description={summary}>
  <div class="hero-pattern flex items-end">
    <Mandala class="mandala-decor" />
    <div class="hero-content container-page w-full py-12 sm:py-16 lg:py-20">
      <p class="eyebrow text-marigold-300">Temple Projects</p>
      <h1 class="mt-2 text-white" data-goal-hero-title>{goal.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-ivory-100" data-goal-hero-summary>{summary}</p>
      <div class="mt-7 flex flex-wrap items-center gap-2.5 text-sm text-ivory-50">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 ring-1 ring-white/20" data-goal-hero-target-badge class:list={{ hidden: goal.targetCents <= 0 }}>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-marigold-300" aria-hidden="true"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4" /><circle cx="12" cy="12" r="0.5" /></svg>
          Goal <span data-goal-hero-target>{goal.targetCents > 0 ? formatGoalAmount(goal.targetCents) : ''}</span>
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 ring-1 ring-white/20">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-marigold-300" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
          Tax deductible
        </span>
      </div>
      <button type="button" class="btn-primary mt-8" data-goal-cta-hero data-buy data-buy-type="fundraising" data-buy-item={goal.id} data-buy-title={goal.title} data-buy-fallback={goal.url} data-buy-embed={goal.embedUrl}>Donate to This Project</button>
    </div>
  </div>

  <div class="container-page grid gap-10 py-14 sm:py-16 lg:grid-cols-[3fr_2fr] lg:items-start" data-goal-page data-goal-id={goal.id}>
    <article>
      <!-- Photos load in the browser: their signed URLs expire within the hour. -->
      <div data-goal-photos class="mb-10 hidden space-y-3"></div>
      <div class="prose-temple" data-goal-description>
        <Fragment set:html={descriptionToHtml(goal.description)} />
      </div>
    </article>

    <aside class="space-y-6 lg:sticky lg:top-24">
      <div class="card p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="eyebrow">Project Goal</p>
            <p class="mt-1 font-display text-3xl font-semibold text-maroon-700" data-goal-target>{goal.targetCents > 0 ? formatGoalAmount(goal.targetCents) : 'Community-funded'}</p>
          </div>
          <button type="button" class="share-trigger flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-ivory-200 text-ivory-500 hover:border-marigold-300 hover:bg-marigold-50 hover:text-maroon-700" aria-label="Share this project" data-share-title={goal.title}>
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 10.6 15.4 6.9M8.6 13.4l6.8 3.7" /></svg>
          </button>
        </div>

        <div data-goal-progress class="mt-5 hidden">
          <div class="flex items-baseline justify-between text-sm">
            <span class="font-display font-semibold text-maroon-700" data-goal-raised></span>
            <span class="text-xs font-medium text-ivory-500" data-goal-percent></span>
          </div>
          <div class="mt-1.5 h-2.5 w-full overflow-hidden rounded-full bg-ivory-200">
            <div class="h-full rounded-full bg-marigold-500" data-goal-bar style="width: 0%"></div>
          </div>
        </div>

        <button type="button" class="btn-primary mt-6 w-full" data-goal-cta data-buy data-buy-type="fundraising" data-buy-item={goal.id} data-buy-title={goal.title} data-buy-fallback={goal.url} data-buy-embed={goal.embedUrl}>Donate to This Project</button>
        <p class="mt-4 text-center text-xs text-ivory-500">
          Give right here, securely. Your gift counts directly toward this project, and all gifts are tax deductible.
        </p>
      </div>

      <a href="/temple-projects/" class="block text-center text-sm font-semibold text-maroon-700 hover:underline">← All Temple Projects</a>
    </aside>
  </div>

  <!-- Other projects, live from the feed, just above the footer. Hides itself
       if this is the temple's only project. -->
  <section id="other-projects" class="border-t border-ivory-200 bg-white py-16 sm:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Keep Exploring</p>
        <h2 class="mt-2">Other Temple Projects</h2>
        <p class="mt-4 text-ivory-600">More ways to help the temple grow and serve the community.</p>
      </div>
      <div class="mt-12">
        <GoalGrid urlMap={urlMap} excludeId={goal.id} wrapperId="other-projects" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchTweebleFundraising, formatGoalAmount } from '../../lib/tweeble-client';
  import { descriptionToHtml, summaryFromDescription } from '../../lib/description';
  import { initShareButtons } from '../../lib/share-widget';
  import { initCheckoutButtons } from '../../lib/checkout';
  initShareButtons();
  initCheckoutButtons();

  const page = document.querySelector<HTMLElement>('[data-goal-page]');

  if (page) {
    (async () => {
      try {
        const goals = await fetchTweebleFundraising();
        const goal = goals.find((g) => g.id === page.dataset.goalId);

        if (!goal) {
          // The Fundraising feed is the source of truth: if this project is
          // no longer listed, don't invite contributions to it.
          document.querySelectorAll<HTMLElement>('[data-goal-cta], [data-goal-cta-hero]').forEach((btn) => {
            const link = document.createElement('a');
            link.className = btn.className;
            link.href = '/temple-projects/';
            link.textContent = 'See Current Projects';
            btn.replaceWith(link);
          });
          return;
        }

        // The page was pre-built from whatever this goal looked like at the
        // last deploy — refresh every text field from the live feed too, so
        // an edit made on Tweeble (title, story, target) shows up without
        // waiting on a redeploy, exactly like the progress bar already does.
        document.title = document.title.replace(/^[^|]+/, `${goal.title} `);
        const heroTitle = page.querySelector('[data-goal-hero-title]');
        if (heroTitle) heroTitle.textContent = goal.title;
        const heroSummary = page.querySelector('[data-goal-hero-summary]');
        if (heroSummary) heroSummary.textContent = summaryFromDescription(goal.description);
        const descHolder = page.querySelector('[data-goal-description]');
        if (descHolder) descHolder.innerHTML = descriptionToHtml(goal.description);

        const heroTargetBadge = page.querySelector<HTMLElement>('[data-goal-hero-target-badge]');
        const heroTargetText = page.querySelector('[data-goal-hero-target]');
        if (heroTargetBadge && heroTargetText) {
          if (goal.targetCents > 0) {
            heroTargetText.textContent = formatGoalAmount(goal.targetCents);
            heroTargetBadge.classList.remove('hidden');
          } else {
            heroTargetBadge.classList.add('hidden');
          }
        }

        for (const trigger of page.querySelectorAll<HTMLElement>('[data-goal-cta], [data-goal-cta-hero]')) {
          trigger.dataset.buyTitle = goal.title;
          trigger.dataset.buyFallback = goal.url;
          if (goal.embedUrl) trigger.dataset.buyEmbed = goal.embedUrl;
        }

        if (goal.targetCents > 0) {
          const target = page.querySelector('[data-goal-target]');
          if (target) target.textContent = formatGoalAmount(goal.targetCents);
          const raised = goal.raisedCents ?? 0;
          const pct = Math.min(100, Math.round((raised / goal.targetCents) * 100));
          const donors = goal.donorCount ?? 0;
          page.querySelector('[data-goal-raised]')!.textContent = raised > 0 ? `${formatGoalAmount(raised)} raised` : 'Be the first to give';
          page.querySelector('[data-goal-percent]')!.textContent =
            raised > 0 ? `${pct}% of goal${donors > 0 ? ` · ${donors} donor${donors === 1 ? '' : 's'}` : ''}` : '';
          page.querySelector<HTMLElement>('[data-goal-bar]')!.style.width = `${pct}%`;
          page.querySelector('[data-goal-progress]')!.classList.remove('hidden');
        }

        const photos = goal.photoUrls ?? [];
        const holder = page.querySelector<HTMLElement>('[data-goal-photos]');
        if (holder && photos.length > 0) {
          const [first, ...rest] = photos;
          const big = document.createElement('img');
          big.src = first;
          big.alt = goal.title;
          big.className = 'w-full rounded-2xl shadow-lift';
          holder.appendChild(big);
          if (rest.length > 0) {
            const row = document.createElement('div');
            row.className = 'grid grid-cols-2 gap-3 sm:grid-cols-3';
            for (const url of rest) {
              const thumb = document.createElement('img');
              thumb.src = url;
              thumb.alt = goal.title;
              thumb.loading = 'lazy';
              thumb.className = 'h-32 w-full rounded-xl object-cover';
              row.appendChild(thumb);
            }
            holder.appendChild(row);
          }
          holder.classList.remove('hidden');
        }

        const shareBtn = page.querySelector<HTMLElement>('.share-trigger');
        if (shareBtn) shareBtn.dataset.shareUrl = location.href.split('#')[0];
      } catch (err) {
        console.error('Failed to load Tweeble fundraising goal', err);
      }
    })();
  }
</script>
