---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import altarHero from '../../assets/photos/altar-durga-shiva-ganesh-diyas.jpg';

const deities = (await getCollection('deities')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Deities" description="The seven deities enshrined at Shri Shiv Dham Hindu Temple.">
  <PageHero
    eyebrow="Worship"
    title="Deities of Shiv Dham"
    description="Seven murtis are enshrined at the temple, each honored with daily aarti and dedicated festival celebrations."
    image={altarHero}
    imageAlt="The temple altar, lit with diyas for evening worship"
  />

  <div class="container-page py-16 sm:py-20">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {deities.map((deity) => (
        <a href={`/deities/${deity.id}/`} class="card-photo group">
          {deity.data.image ? (
            <Image src={deity.data.image} alt={deity.data.imageAlt ?? deity.data.title} width={480} height={340} class="h-56" />
          ) : (
            <div class="hero-pattern flex h-56 items-center justify-center">
              <span class="font-display text-5xl text-marigold-200">ॐ</span>
            </div>
          )}
          <div class="p-6">
            {deity.data.epithet && <p class="eyebrow">{deity.data.epithet}</p>}
            <h2 class="mt-1.5 font-display text-2xl font-semibold text-maroon-700 group-hover:text-marigold-600">{deity.data.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-ivory-600 line-clamp-3">{deity.data.summary}</p>
            {deity.data.sacredDays.length > 0 && (
              <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-marigold-600">
                {deity.data.sacredDays.join(' · ')}
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
