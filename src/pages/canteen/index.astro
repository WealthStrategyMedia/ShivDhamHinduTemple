---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import canteenImage from '../../assets/photos/canteen.jpg';

const page = await getEntry('pages', 'canteen');
const { Content } = page ? await render(page) : { Content: null };

const MENU = ['Idli', 'Dosa', 'Chole Puri', 'Samosa Chat', 'Gulaab Jamun', 'Ice Cream', 'Samosa'];
---

<BaseLayout title="Canteen" description={page?.data.summary}>
  <PageHero
    eyebrow="Visit"
    title="Trimurthi Canteen"
    description={page?.data.summary}
    image={canteenImage}
    imageAlt="The Trimurthi Canteen serving devotees at the temple"
    focus="top"
  />

  <div class="container-page py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[3fr_2fr] lg:items-start">
      {Content && (
        <article class="prose-temple">
          <Content />
        </article>
      )}

      <aside class="card p-6">
        <p class="eyebrow">Weekend Hours</p>
        <p class="mt-2 font-display text-2xl font-semibold text-maroon-700">Sat &amp; Sun</p>
        <p class="text-lg text-ivory-700">11:00 AM – 3:00 PM</p>

        <p class="eyebrow mt-6">On the Menu</p>
        <ul class="mt-3 grid grid-cols-2 gap-2 text-sm">
          {MENU.map((item) => (
            <li class="rounded-lg bg-ivory-100 px-3 py-2 text-ivory-800">{item}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</BaseLayout>
