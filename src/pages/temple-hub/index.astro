---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Mandala from '../../components/Mandala.astro';
import { TWEEBLE } from '../../lib/site';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import communityImage from '../../assets/photos/community-group.jpg';

const FEATURES = [
  {
    icon: 'calendar',
    title: 'Register for Every Event',
    body: 'Browse everything on the temple\'s calendar, from Shravan Mela to Ganesh Mahotsavam, and register in a couple of taps.',
  },
  {
    icon: 'bag',
    title: 'Book Services & Products',
    body: 'See every puja, homam, and life-cycle ceremony the temple offers, with pricing up front, and book it directly.',
  },
  {
    icon: 'id',
    title: 'Become a Member',
    body: 'Sign up for temple membership right on the Hub, with everything that comes with it, in one straightforward flow.',
  },
  {
    icon: 'news',
    title: 'Read the Latest News',
    body: 'The temple\'s blog lives on the Hub — festival recaps, community milestones, and the occasional surprise, like the temple getting a mention on the red carpet at the Emmys.',
  },
  {
    icon: 'coin',
    title: 'Earn by Sharing',
    body: 'Share a temple event, a service, or an invitation to become a member, and earn real money when it leads to a booking or a new member. Keep the payout, or donate it straight back to the temple — your choice.',
  },
  {
    icon: 'heart',
    title: 'Greeting Cards for Nepal Flood Relief',
    body: 'Send a greeting card to family and loved ones through the Hub; doing so helps support Nepal Flood Disaster Relief efforts.',
  },
] as const;
---

<BaseLayout
  title="Temple Hub"
  description="Register for events, book services, become a member, read the latest news, and earn by sharing it all — the temple's Hub on Tweeble."
>
  <PageHero
    eyebrow="Temple Hub"
    title="Everything at Shri Shiv Dham, in One Place"
    description="Events, services and products, membership, and the temple's latest news all live on the Temple Hub — and every temple-goer can earn money just by sharing it."
    image={communityImage}
    imageAlt="The Shiv Dham community gathered together at the temple"
  >
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={TWEEBLE.hubUrl} target="_blank" rel="noopener" class="btn-primary">Open the Temple Hub</a>
    </div>
  </PageHero>

  <div class="container-page py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">One Link, Everything Temple</p>
      <h2 class="mt-2">What's Waiting for You on the Hub</h2>
      <p class="mt-4 text-ivory-600">
        The Temple Hub is powered by Tweeble. It's free to use, and it's how the temple runs its events, services, membership, and news, all from one place.
      </p>
    </div>

    <div class="mx-auto mt-10 w-full max-w-xs">
      <YouTubeEmbed id="UuBWgNTjyGg" title="Join Shri Shiv Dham Hindu Temple Orlando" orientation="portrait" />
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {FEATURES.map((f) => (
        <div class="card p-6">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-marigold-100 text-marigold-600">
            {f.icon === 'calendar' && (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2" /><path d="M8 3v4M16 3v4M3.5 10h17" /></svg>
            )}
            {f.icon === 'bag' && (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l1 13H5L6 8Z" /><path d="M9 8V6a3 3 0 1 1 6 0v2" /></svg>
            )}
            {f.icon === 'id' && (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="8.5" cy="11" r="2" /><path d="M5.5 16.5c.7-1.6 1.8-2.3 3-2.3s2.3.7 3 2.3M14.5 10h5M14.5 13.5h5" /></svg>
            )}
            {f.icon === 'news' && (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h13v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Z" /><path d="M17 8h3v11a2 2 0 0 1-2 2h-1" /><path d="M7.5 9h6M7.5 12.5h6M7.5 16h4" /></svg>
            )}
            {f.icon === 'coin' && (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v10M9.5 9.3c0-1.3 1.1-2.1 2.5-2.1s2.5.7 2.5 1.8c0 2.4-5 1.4-5 3.9 0 1.1 1.1 1.8 2.5 1.8s2.5-.8 2.5-2.1" /></svg>
            )}
            {f.icon === 'heart' && (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7.5-4.7-9.8-9.9C.8 6.6 3 3.5 6.3 3.5c2 0 3.5 1 5.7 3.5 2.2-2.5 3.7-3.5 5.7-3.5 3.3 0 5.5 3.1 4.1 6.6C19.5 15.3 12 20 12 20Z" /></svg>
            )}
          </span>
          <h3 class="mt-4 font-display text-lg font-semibold text-maroon-700">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ivory-600">{f.body}</p>
        </div>
      ))}
    </div>

    <div class="section-break my-16">
      <Mandala class="h-8 w-8 text-marigold-400" opacity={0.6} />
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="card p-7">
        <h3 class="font-display text-lg font-semibold text-maroon-700">Always Someone Listening</h3>
        <p class="mt-2 text-sm leading-relaxed text-ivory-600">
          The Temple Hub's community is monitored seven days a week, so questions, concerns, or feedback get a response any day of the week.
        </p>
      </div>
      <div class="card p-7">
        <h3 class="font-display text-lg font-semibold text-maroon-700">Training &amp; Support</h3>
        <p class="mt-2 text-sm leading-relaxed text-ivory-600">
          New to the Hub? Training videos are available on request, and the temple holds a training session every other Friday; the schedule will be posted here shortly. In the meantime, <a href="/contact-us/" class="font-semibold text-maroon-700 underline decoration-marigold-300 decoration-2 underline-offset-2">contact the temple office</a> to request a training video or ask about the next session.
        </p>
      </div>
    </div>

    <div class="hero-pattern relative mt-16 overflow-hidden rounded-2xl">
      <Mandala class="mandala-decor" opacity={0.18} />
      <div class="relative z-10 flex flex-col items-center gap-5 px-6 py-12 text-center sm:py-16">
        <h2 class="max-w-xl text-white">Open the Temple Hub</h2>
        <p class="max-w-lg text-ivory-100">
          Events, services, membership, and news — all in one place, and free to use. Opens in a new tab so you don't lose your place here.
        </p>
        <a href={TWEEBLE.hubUrl} target="_blank" rel="noopener" class="btn-primary">Open the Temple Hub</a>
      </div>
    </div>
  </div>
</BaseLayout>
