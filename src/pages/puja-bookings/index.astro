---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import congregationHero from '../../assets/photos/congregation-puja.jpg';
---

<BaseLayout title="Temple Services" description="Every puja, homam, and life-cycle ceremony the temple offers, with live pricing from the Temple Hub.">
  <PageHero
    eyebrow="Worship"
    title="Temple Services"
    description="Every ceremony the temple offers, with live pricing from the Temple Hub. Select one to see full details and book."
    image={congregationHero}
    imageAlt="Priests and devotees during worship at the temple"
  />

  <div class="container-page py-16 sm:py-20">
    <div class="relative mx-auto max-w-lg">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ivory-400" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input
        id="service-search"
        type="search"
        placeholder="Search services — e.g. Homam, Wedding, Abhishekam…"
        class="w-full rounded-full border border-ivory-300 bg-white py-3 pl-11 pr-4 text-sm focus:border-maroon-400"
      />
    </div>

    <p id="services-count" class="mt-4 text-center text-sm text-ivory-500"></p>

    <div id="services-loading" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite">
      {Array.from({ length: 9 }).map(() => (
        <div class="card-photo animate-pulse">
          <div class="h-56 bg-ivory-200"></div>
          <div class="space-y-2 p-6">
            <div class="h-5 w-3/4 rounded bg-ivory-200"></div>
            <div class="h-3 w-full rounded bg-ivory-200"></div>
          </div>
        </div>
      ))}
    </div>

    <div id="services-error" class="mt-8 hidden rounded-2xl border border-marigold-200 bg-marigold-50 p-8 text-center">
      <p class="text-ivory-700">We couldn't load live services just now. Please try refreshing, or see the temple's local service archive below in the meantime.</p>
    </div>

    <div id="services-empty" class="mt-8 hidden rounded-2xl bg-ivory-100 p-8 text-center">
      <p class="text-ivory-700">No services match that search.</p>
    </div>

    <div id="services-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

    <div class="mt-16 rounded-2xl bg-ivory-100 p-8 text-center">
      <p class="text-ivory-700">
        Prefer the temple's own category-organized list? See the <a href="/puja-bookings/archive/" class="font-semibold text-maroon-700 underline decoration-marigold-300 decoration-2 underline-offset-2">Services Archive</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<template id="service-card-template">
  <a class="card-photo group" target="_blank" rel="noopener">
    <div class="relative h-56 overflow-hidden bg-gradient-to-br from-maroon-600 to-maroon-800">
      <img class="service-cover hidden h-56 w-full object-cover" loading="lazy" alt="" />
      <span class="service-fallback flex h-56 items-center justify-center font-display text-3xl text-marigold-200">ॐ</span>
    </div>
    <div class="p-6">
      <div class="flex items-start justify-between gap-3">
        <h3 class="service-name font-display text-base font-semibold text-maroon-700 group-hover:text-marigold-600"></h3>
        <span class="service-price shrink-0 font-display text-base font-semibold text-maroon-700"></span>
      </div>
      <p class="service-desc mt-2 text-sm text-ivory-600 line-clamp-2"></p>
      <div class="mt-3 flex items-center justify-between">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-maroon-700">
          Book on the Temple Hub
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
        </span>
        <button type="button" class="share-trigger flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-ivory-400 hover:bg-ivory-100 hover:text-maroon-700" aria-label="Share this service">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 10.6 15.4 6.9M8.6 13.4l6.8 3.7" /></svg>
        </button>
      </div>
    </div>
  </a>
</template>

<script>
  import { fetchTweebleServices, formatCents, truncate, type TweebleService } from '../../lib/tweeble-client';
  import { initShareButtons } from '../../lib/share-widget';
  initShareButtons();

  const loadingEl = document.getElementById('services-loading');
  const errorEl = document.getElementById('services-error');
  const emptyEl = document.getElementById('services-empty');
  const gridEl = document.getElementById('services-grid');
  const countEl = document.getElementById('services-count');
  const searchInput = document.getElementById('service-search') as HTMLInputElement | null;
  const template = document.getElementById('service-card-template') as HTMLTemplateElement | null;

  let allServices: TweebleService[] = [];

  function renderServices(services: TweebleService[]) {
    if (!gridEl || !template) return;
    gridEl.innerHTML = '';
    emptyEl?.classList.toggle('hidden', services.length > 0);
    if (countEl) countEl.textContent = services.length > 0 ? `${services.length} service${services.length === 1 ? '' : 's'}` : '';

    for (const service of services) {
      const node = template.content.cloneNode(true) as DocumentFragment;
      const link = node.querySelector('a')!;
      link.href = service.url;

      const shareBtn = node.querySelector<HTMLElement>('.share-trigger')!;
      shareBtn.dataset.shareUrl = service.url;
      shareBtn.dataset.shareTitle = service.name;

      const img = node.querySelector<HTMLImageElement>('.service-cover')!;
      const fallback = node.querySelector<HTMLElement>('.service-fallback')!;
      if (service.coverPhotoUrl) {
        img.src = service.coverPhotoUrl;
        img.alt = service.name;
        img.classList.remove('hidden');
        fallback.classList.add('hidden');
      }

      node.querySelector('.service-name')!.textContent = service.name;
      node.querySelector('.service-price')!.textContent = formatCents(service.priceCents);
      node.querySelector('.service-desc')!.textContent = truncate(service.description, 110);

      gridEl.appendChild(node);
    }
  }

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    const filtered = q
      ? allServices.filter((s) => s.name.toLowerCase().includes(q) || s.description.toLowerCase().includes(q))
      : allServices;
    renderServices(filtered);
  });

  (async () => {
    try {
      allServices = await fetchTweebleServices();
      renderServices(allServices);
    } catch (err) {
      errorEl?.classList.remove('hidden');
      console.error('Failed to load Tweeble services', err);
    } finally {
      loadingEl?.remove();
    }
  })();
</script>
