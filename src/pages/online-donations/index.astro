---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DonationForm from '../../components/DonationForm.astro';
import PageHero from '../../components/PageHero.astro';

const page = await getEntry('pages', 'online-donations');
const { Content } = page ? await render(page) : { Content: null };
---

<BaseLayout tweeble title="Online Donations" description={page?.data.summary}>
  <PageHero eyebrow="Give" title="Online Donations" description={page?.data.summary} image={page?.data.hero} imageAlt={page?.data.heroAlt} compact />

  <div class="container-page grid gap-12 py-14 lg:grid-cols-[3fr_2fr]">
    {Content && (
      <article class="prose-temple">
        <Content />
      </article>
    )}
    <div>
      <DonationForm fund="General Fund" />
    </div>
  </div>
</BaseLayout>
