---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProgramGrid from '../components/ProgramGrid.astro';
import Mandala from '../components/Mandala.astro';
import { SITE } from '../lib/site';
import { formatCents } from '../lib/tweeble-client';
import { getProgramPages, getProgramUrlMap, PROGRAM_EXTRA_LINKS } from '../lib/programs';
import { descriptionToHtml } from '../lib/description';

// Serves two flat, top-level sets of pages at the same route level:
// - `pages`: general editorial content (about, facilities, policies, ...)
// - programs: one page per program in the temple's Tweeble Programs feed,
//   at flat URLs like /yoga-classes/ to match the site's existing structure.
export async function getStaticPaths() {
  // Slugs served by their own dedicated route file instead of this generic
  // one — that dedicated file needs more than the plain page template (e.g.
  // contact-us/index.astro adds the working contact form). Declared inside
  // getStaticPaths because Astro extracts this function into its own
  // isolated module at build time, which does not carry along top-level
  // frontmatter statements declared outside of it.
  const OWN_ROUTE_SLUGS = new Set([
    'contact-us',
    'online-donations',
    'religious-dates-and-festivals',
    'gallery',
    'guruji-biography',
    'volunteering',
    'your-voice-matters',
    'summer-camp-registration-form',
    'temple-facilities',
    'canteen',
    'temple-store',
    'faq',
    'brahmrishi-mission-centres-india-and-abroad',
    'membership-drive',
  ]);

  const pages = (await getCollection('pages')).filter((entry) => !OWN_ROUTE_SLUGS.has(entry.id));
  const programPages = await getProgramPages();

  const pageEntries = pages.map((entry) => ({
    params: { slug: entry.id.replace(/\/index$/, '') },
    props: { kind: 'page' as const, entry, programPage: undefined },
  }));

  const programEntries = programPages.map((programPage) => ({
    params: { slug: programPage.slug },
    props: { kind: 'program' as const, entry: undefined, programPage },
  }));

  return [...pageEntries, ...programEntries];
}

const { kind, entry, programPage } = Astro.props;
const program = programPage?.program;

const { Content } = entry ? await render(entry) : { Content: null };
const title = program ? program.title : (entry!.data.seoTitle ?? entry!.data.title);
const description = program ? program.shortDescription : (entry!.data.seoDescription ?? entry!.data.summary);
const heroImage = entry?.data.hero;
const heroImageAlt = entry?.data.heroAlt;

const programUrlMap = program ? await getProgramUrlMap() : {};
const extraLink = program ? PROGRAM_EXTRA_LINKS[program.title.trim().toLowerCase()] : undefined;
const programCost = program ? (program.isFree ? 'Free' : formatCents(program.priceCents)) : '';

// General pages get a "keep exploring" card so the page never just dead-ends in text.
const EXPLORE_MORE = [
  { label: 'Temple Services', href: '/puja-bookings/', blurb: 'Book a ceremony, homam, or life-cycle ritual.' },
  { label: 'Events Calendar', href: '/events/', blurb: "See what's happening at the temple this month." },
  { label: 'Make a Donation', href: '/online-donations/', blurb: "Support the temple's worship and community programs." },
].filter((l) => l.href !== `/${entry?.id}/`);
---

<BaseLayout title={title} description={description} noindex={entry ? entry.data.noindex : false}>
  <PageHero
    eyebrow={program ? 'Programs' : SITE.shortName}
    title={title}
    description={description}
    image={heroImage}
    imageAlt={heroImageAlt}
    compact
  >
    {program && (
      <>
        <div class="mt-7 flex flex-wrap items-center gap-2.5 text-sm text-ivory-50">
          {program.scheduleLabel && (
            <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 ring-1 ring-white/20">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-marigold-300" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
              <span data-fact="schedule">{program.scheduleLabel}</span>
            </span>
          )}
          <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 ring-1 ring-white/20">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-marigold-300" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z" /><circle cx="7.5" cy="7.5" r="1" /></svg>
            <span data-fact="cost">{programCost}</span>
          </span>
          {program.locationLabel && (
            <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 ring-1 ring-white/20">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-marigold-300" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
              {program.locationLabel}
            </span>
          )}
        </div>
        <a href={program.url} target="_blank" rel="noopener" class="btn-primary mt-8" data-program-cta-hero>Register on the Temple Hub</a>
      </>
    )}
  </PageHero>

  <div class="container-page py-14 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[3fr_2fr] lg:items-start">
      <article class="container-prose mx-0 max-w-none px-0">
        <div class="prose-temple">
          {program ? <Fragment set:html={descriptionToHtml(program.description)} /> : Content && <Content />}
        </div>
      </article>

      <aside class="space-y-6 lg:sticky lg:top-24">
        {program ? (
          <!-- Static from the feed at build time; the script below refreshes
               it live (cover photo, price, next session) in the browser. -->
          <div class="card overflow-hidden" data-program-card data-program-id={program.id}>
            <img data-program-cover class="hidden w-full" alt={program.title} />
            <div class="p-6">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="eyebrow">Registration</p>
                  <p class="mt-1 font-display text-3xl font-semibold text-maroon-700" data-fact="cost">{programCost}</p>
                </div>
                <button type="button" class="share-trigger flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-ivory-200 text-ivory-500 hover:border-marigold-300 hover:bg-marigold-50 hover:text-maroon-700" aria-label="Share this program" data-share-title={program.title}>
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 10.6 15.4 6.9M8.6 13.4l6.8 3.7" /></svg>
                </button>
              </div>

              <dl class="mt-5 space-y-2.5 text-sm">
                {program.scheduleLabel && (
                  <div class="flex items-start justify-between gap-3 rounded-xl border border-ivory-200 bg-ivory-50 px-4 py-3">
                    <dt class="font-medium text-ivory-800">Schedule</dt>
                    <dd class="text-right text-ivory-600" data-fact="schedule">{program.scheduleLabel}</dd>
                  </div>
                )}
                <div data-fact-row="next" class="hidden items-start justify-between gap-3 rounded-xl border border-ivory-200 bg-ivory-50 px-4 py-3">
                  <dt class="font-medium text-ivory-800">Next Session</dt>
                  <dd class="text-right text-ivory-600" data-fact="next"></dd>
                </div>
                {program.locationLabel && (
                  <div class="flex items-start justify-between gap-3 rounded-xl border border-ivory-200 bg-ivory-50 px-4 py-3">
                    <dt class="font-medium text-ivory-800">Location</dt>
                    <dd class="text-right text-ivory-600">{program.locationLabel}</dd>
                  </div>
                )}
                <div class="flex items-start justify-between gap-3 rounded-xl border border-ivory-200 bg-ivory-50 px-4 py-3">
                  <dt class="font-medium text-ivory-800">Ages</dt>
                  <dd class="text-right text-ivory-600" data-fact="ages">{program.minimumAge ? `${program.minimumAge}+` : 'All welcome'}</dd>
                </div>
              </dl>

              <a href={program.url} target="_blank" rel="noopener" class="btn-primary mt-6 w-full" data-program-cta>Register on the Temple Hub</a>
              {extraLink && <a href={extraLink.href} class="btn-ghost mt-3 w-full">{extraLink.label}</a>}
              <p class="mt-4 text-center text-xs text-ivory-500">Registration and payment happen securely on the Temple Hub. Questions first? <a href="/contact-us/" class="underline">Contact the temple office</a>.</p>
            </div>
          </div>
        ) : (
          <div class="hero-pattern relative overflow-hidden rounded-2xl p-6">
            <Mandala class="mandala-decor" opacity={0.18} />
            <div class="relative z-10">
              <h2 class="font-display text-lg font-semibold text-white">Have a Question?</h2>
              <p class="mt-2 text-sm text-ivory-100">The temple office is happy to help with anything not covered here.</p>
              <a href="/contact-us/" class="btn-primary mt-5 w-full">Contact Us</a>
            </div>
          </div>
        )}

        {!program && (
          <div class="card p-6">
            <h2 class="font-display text-base font-semibold text-maroon-700">Keep Exploring</h2>
            <ul class="mt-4 space-y-3">
              {EXPLORE_MORE.map((l) => (
                <li>
                  <a href={l.href} class="block rounded-xl border border-ivory-200 bg-ivory-50 px-4 py-3 transition hover:border-marigold-300 hover:bg-marigold-50">
                    <span class="block text-sm font-semibold text-maroon-700">{l.label}</span>
                    <span class="block text-xs text-ivory-500">{l.blurb}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>

  {program && (
    <!-- Other programs, live from the feed, just above the footer — in case a
         visitor decides against this one but would enjoy another. Hides
         itself if this is the temple's only program. -->
    <section id="other-programs" class="border-t border-ivory-200 bg-white py-16 sm:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow">Keep Exploring</p>
          <h2 class="mt-2">Other Programs You May Love</h2>
          <p class="mt-4 text-ivory-600">More ways to learn, practice, and grow with the temple community.</p>
        </div>
        <div class="mt-12">
          <ProgramGrid urlMap={programUrlMap} excludeId={program.id} wrapperId="other-programs" />
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { fetchTweeblePrograms, formatCents, formatEventDate } from '../lib/tweeble-client';

  const card = document.querySelector<HTMLElement>('[data-program-card]');

  if (card) {
    const setFact = (name: string, value: string) =>
      document.querySelectorAll<HTMLElement>(`[data-fact="${name}"]`).forEach((el) => (el.textContent = value));

    (async () => {
      try {
        const programs = await fetchTweeblePrograms();
        const program = programs.find((p) => p.id === card.dataset.programId);

        if (!program) {
          // The Programs feed is the source of truth: if this program is no
          // longer listed there, don't invite sign-ups for it.
          document.querySelectorAll<HTMLAnchorElement>('[data-program-cta], [data-program-cta-hero]').forEach((a) => {
            a.textContent = 'See Current Programs';
            a.href = '/programs/';
            a.removeAttribute('target');
          });
          const note = document.createElement('p');
          note.className = 'mt-5 rounded-xl bg-marigold-50 px-4 py-3 text-sm text-ivory-700';
          note.textContent = "This program isn't currently scheduled. See what's running now:";
          card.querySelector('[data-program-cta]')?.before(note);
          return;
        }

        if (program.scheduleLabel) setFact('schedule', program.scheduleLabel);
        setFact('cost', program.isFree ? 'Free' : formatCents(program.priceCents));
        if (program.minimumAge) setFact('ages', `${program.minimumAge}+`);
        if (program.nextOccurrence) {
          setFact('next', formatEventDate(program.nextOccurrence));
          const row = card.querySelector<HTMLElement>('[data-fact-row="next"]');
          row?.classList.remove('hidden');
          row?.classList.add('flex');
        }

        if (program.coverPhotoUrl) {
          const img = card.querySelector<HTMLImageElement>('[data-program-cover]')!;
          img.src = program.coverPhotoUrl;
          img.classList.remove('hidden');
        }

        const shareBtn = card.querySelector<HTMLElement>('.share-trigger');
        if (shareBtn) shareBtn.dataset.shareUrl = location.href.split('#')[0];
      } catch (err) {
        console.error('Failed to load Tweeble programs', err);
      }
    })();

    import('../lib/share-widget').then(({ initShareButtons }) => initShareButtons());
  }
</script>
