---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DonationForm from '../../components/DonationForm.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout tweeble title="General Fund" description="Support the temple's day-to-day operations and worship.">
  <PageHero eyebrow="Give" title="General Fund" description="Supports day-to-day temple operations and worship." compact />

  <div class="container-page grid gap-12 py-14 lg:grid-cols-[3fr_2fr]">
    <article class="prose-temple">
      <p>
        Gifts to the General Fund sustain the everyday life of the temple: daily puja, priest support, utilities, and the countless small costs of keeping the temple open and welcoming every day of the year.
      </p>
      <p>
        Looking for a different fund? See <a href="/donations/shivadham/">Shivadham</a> or <a href="/support-the-temple-garden/">Temple Garden</a>, or visit <a href="/online-donations/">Online Donations</a> for all giving options.
      </p>
    </article>
    <div>
      <DonationForm fund="General Fund" />
    </div>
  </div>
</BaseLayout>
