---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import VolunteerForm from '../../components/VolunteerForm.astro';
import communityImage from '../../assets/photos/community-group.jpg';
---

<BaseLayout
  title="Volunteering"
  description="Volunteer at Shri Shiv Dham Hindu Temple and become part of the community."
>
  <PageHero
    eyebrow="Get Involved"
    title="Volunteer at the Temple"
    description="Are you looking for a way to give back to your community and take part in something meaningful? We invite you to become a volunteer."
    image={communityImage}
    imageAlt="The Shiv Dham community gathered together at the temple"
    compact
  />

  <div class="container-page py-14 sm:py-16">
    <article class="prose-temple container-prose mx-auto px-0 text-center">
      <p>
        By volunteering, you'll have the opportunity to contribute to the temple's activities, events, and day-to-day operations, helping to create a welcoming and vibrant environment for all. Whether you have a few hours to spare or can commit regularly, your time and talents are invaluable to us.
      </p>
      <p>
        Share your availability and interests below, and a member of the temple's volunteer coordination team will follow up with you. We look forward to welcoming you!
      </p>
    </article>
    <div class="mx-auto mt-10 max-w-2xl">
      <VolunteerForm />
    </div>
  </div>
</BaseLayout>
