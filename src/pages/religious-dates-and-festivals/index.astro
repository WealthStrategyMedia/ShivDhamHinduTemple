---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import festivals2026 from '../../data/festivals-2026.json';
import { MONTH_NAMES } from '../../lib/calendar';
import { matchFestival } from '../../data/festival-glossary';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';

const page = await getEntry('pages', 'religious-dates-and-festivals');
const { Content } = page ? await render(page) : { Content: null };

const byMonth = MONTH_NAMES.map((name, i) => {
  const monthStr = String(i + 1).padStart(2, '0');
  const days = (festivals2026 as { date: string; festivals: string[] }[]).filter((d) =>
    d.date.startsWith(`2026-${monthStr}`),
  );
  return { name, days };
});
---

<BaseLayout title="Religious Dates & Festivals" description={page?.data.summary}>
  <PageHero
    eyebrow="Worship"
    title="Religious Dates &amp; Festivals"
    description={page?.data.summary}
    image={page?.data.hero}
    imageAlt={page?.data.heroAlt}
    compact
  />

  <div class="container-page py-16 sm:py-20">
    {Content && (
      <div class="prose-temple container-prose mx-auto mb-10 px-0">
        <Content />
      </div>
    )}

    <div class="mx-auto mb-14 max-w-md">
      <YouTubeEmbed id="2pNGn70cW0Y" title="Shravan Mela 2026: A Community Celebration to Remember" orientation="portrait" />
      <p class="mt-3 text-center text-sm text-ivory-500">These dates aren't just entries on a calendar — see one come to life.</p>
    </div>

    <p class="mb-8 text-sm text-ivory-500">Click any observance below to read what it means and how it's celebrated.</p>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {byMonth.map(({ name, days }) => days.length > 0 && (
        <div class="card p-6">
          <h2 class="font-display text-lg font-semibold text-maroon-700">{name} 2026</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            {days.map((d) => (
              <li class="flex gap-3">
                <span class="w-7 shrink-0 font-semibold text-marigold-600">{d.date.slice(-2)}</span>
                <span class="text-ivory-700">
                  {d.festivals.map((f, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={`/religious-dates-and-festivals/${matchFestival(f).slug}/`} class="underline decoration-marigold-300 decoration-2 underline-offset-2 hover:text-maroon-700">{f}</a>
                    </>
                  ))}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
