---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import congregationHero from '../../assets/photos/congregation-puja.jpg';

const FAQS = [
  {
    question: "What are the temple's hours?",
    answer: null,
    schedule: [
      { day: 'Monday – Friday', morning: '8:00 AM – 12:30 PM', evening: '5:00 – 8:30 PM' },
      { day: 'Saturday', morning: '8:00 AM – 8:30 PM', evening: null },
      { day: 'Sunday', morning: '8:00 AM – 8:30 PM', evening: null },
    ],
  },
  {
    question: 'Where is the temple located?',
    answer: 'The temple is at 460 Oberry Hoover Rd, Orlando, FL 32825.',
    link: { label: 'Directions to Our Temple', href: '/directions-to-our-temple/' },
  },
  {
    question: 'Can I book a puja or havan?',
    answer: 'Yes — see the full list of available pujas and havans, with pricing and an online booking form for each.',
    link: { label: 'Temple Services', href: '/puja-bookings/' },
  },
  {
    question: 'Where can I find upcoming festivals and events?',
    answer: 'The Events Calendar is kept up to date with every upcoming festival, puja, and special program, including schedules and timings.',
    link: { label: 'Events Calendar', href: '/events/' },
  },
] as const;
---

<BaseLayout title="Frequently Asked Questions" description="Temple hours, directions, puja bookings, and event information.">
  <PageHero
    eyebrow="Visit"
    title="Frequently Asked Questions"
    description="Quick answers to the questions we hear most. Still stuck on something? The temple office is always happy to help."
    image={congregationHero}
    imageAlt="Devotees gathered for worship at the temple"
    compact
  />

  <div class="container-page py-14 sm:py-16">
    <div class="mx-auto max-w-3xl space-y-5">
      {FAQS.map((faq) => (
        <div class="card p-6 sm:p-8">
          <h2 class="font-display text-lg font-semibold text-maroon-700">{faq.question}</h2>
          {faq.schedule ? (
            <div class="mt-4 overflow-hidden rounded-xl border border-ivory-200">
              <table class="w-full text-sm">
                <thead>
                  <tr class="bg-ivory-100 text-left text-xs font-semibold uppercase tracking-wide text-maroon-700">
                    <th class="px-4 py-2.5">Day</th>
                    <th class="px-4 py-2.5">Morning</th>
                    <th class="px-4 py-2.5">Evening</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ivory-100">
                  {faq.schedule.map((row) => (
                    <tr>
                      <td class="px-4 py-2.5 font-medium text-ivory-800">{row.day}</td>
                      <td class="px-4 py-2.5 text-ivory-600">{row.morning}</td>
                      <td class="px-4 py-2.5 text-ivory-600">{row.evening ?? 'N/A'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <>
              <p class="mt-2 text-sm leading-relaxed text-ivory-600">{faq.answer}</p>
              {faq.link && (
                <a href={faq.link.href} class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-maroon-700 hover:underline">
                  {faq.link.label}
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              )}
            </>
          )}
        </div>
      ))}
    </div>

    <div class="mx-auto mt-10 max-w-3xl hero-pattern relative overflow-hidden rounded-2xl p-8 text-center sm:p-10">
      <div class="relative z-10">
        <h2 class="text-white">Still Have a Question?</h2>
        <p class="mx-auto mt-2 max-w-md text-ivory-100">Reach the temple office directly and we'll get you an answer.</p>
        <a href="/contact-us/" class="btn-primary mt-6">Contact Us</a>
      </div>
    </div>
  </div>
</BaseLayout>
