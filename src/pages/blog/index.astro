---
import { TWEEBLE } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import communityImage from '../../assets/photos/community-group.jpg';
---

<BaseLayout feeds={[TWEEBLE.api.blog]} title="Blog & News" description="Festival recaps, community milestones, and the latest happenings at Shri Shiv Dham Hindu Temple, live from the Temple Hub.">
  <PageHero
    eyebrow="News"
    title="Blog &amp; News"
    description="Festival recaps, community milestones, and the occasional surprise — the temple's latest stories, live from the Temple Hub."
    image={communityImage}
    imageAlt="The Shiv Dham community gathered together at the temple"
  />

  <div class="container-page py-16 sm:py-20">
    <div id="blog-loading" class="grid gap-8 sm:grid-cols-2" aria-live="polite">
      {[0, 1].map(() => (
        <div class="card-photo animate-pulse">
          <div class="h-64 bg-ivory-200"></div>
          <div class="space-y-2 p-6">
            <div class="h-3 w-1/3 rounded bg-ivory-200"></div>
            <div class="h-5 w-4/5 rounded bg-ivory-200"></div>
            <div class="h-3 w-full rounded bg-ivory-200"></div>
          </div>
        </div>
      ))}
    </div>

    <div id="blog-error" class="hidden rounded-2xl border border-marigold-200 bg-marigold-50 p-8 text-center">
      <p class="text-ivory-700">We couldn't load the latest posts just now. Please try refreshing, or visit the <a href="https://www.tweeble.com" target="_blank" rel="noopener" class="font-semibold text-maroon-700 underline">Temple Hub</a> directly.</p>
    </div>

    <div id="blog-empty" class="hidden rounded-2xl bg-ivory-100 p-8 text-center">
      <p class="text-ivory-700">No posts yet — check back soon.</p>
    </div>

    <div id="blog-grid" class="grid gap-8 sm:grid-cols-2"></div>
  </div>
</BaseLayout>

<template id="blog-card-template">
  <a class="card-photo group flex flex-col" target="_blank" rel="noopener">
    <div class="relative h-64 overflow-hidden bg-gradient-to-br from-maroon-600 to-maroon-800">
      <img class="post-cover hidden h-64 w-full object-cover" loading="lazy" alt="" />
      <span class="post-fallback flex h-64 items-center justify-center font-display text-4xl text-marigold-200">ॐ</span>
    </div>
    <div class="flex flex-1 flex-col p-6">
      <p class="post-meta eyebrow"></p>
      <h3 class="post-title mt-1.5 font-display text-xl font-semibold text-maroon-700 group-hover:text-marigold-600"></h3>
      <p class="post-subtitle mt-2 flex-1 text-sm text-ivory-600 line-clamp-3"></p>
      <div class="mt-4 flex items-center justify-between">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-maroon-700">
          Read on the Temple Hub
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
        </span>
        <button type="button" class="share-trigger flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-ivory-400 hover:bg-ivory-100 hover:text-maroon-700" aria-label="Share this post">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 10.6 15.4 6.9M8.6 13.4l6.8 3.7" /></svg>
        </button>
      </div>
    </div>
  </a>
</template>

<script>
  import { loadFeed, truncate, type TweebleBlogPost } from '../../lib/tweeble-client';
  import { TWEEBLE } from '../../lib/site';
  import { initShareButtons } from '../../lib/share-widget';
  initShareButtons();

  const loadingEl = document.getElementById('blog-loading');
  const errorEl = document.getElementById('blog-error');
  const emptyEl = document.getElementById('blog-empty');
  const gridEl = document.getElementById('blog-grid');
  const template = document.getElementById('blog-card-template') as HTMLTemplateElement | null;

  function render(posts: TweebleBlogPost[]) {
    loadingEl?.remove();
    if (!gridEl || !template) return;
    gridEl.replaceChildren();

    const none = !Array.isArray(posts) || posts.length === 0;
    emptyEl?.classList.toggle('hidden', !none);
    if (none) return;

    {
      const sorted = [...posts].sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());
      for (const post of sorted) {
        const node = template.content.cloneNode(true) as DocumentFragment;
        const link = node.querySelector('a')!;
        link.href = post.url;

        const shareBtn = node.querySelector<HTMLElement>('.share-trigger')!;
        shareBtn.dataset.shareUrl = post.url;
        shareBtn.dataset.shareTitle = post.title;

        const img = node.querySelector<HTMLImageElement>('.post-cover')!;
        const fallback = node.querySelector<HTMLElement>('.post-fallback')!;
        if (post.coverImageUrl) {
          img.src = post.coverImageUrl;
          img.alt = post.title;
          img.classList.remove('hidden');
          fallback.classList.add('hidden');
        }

        const published = new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
        node.querySelector('.post-meta')!.textContent = post.authorName ? `${published} · ${post.authorName}` : published;
        node.querySelector('.post-title')!.textContent = post.title;
        node.querySelector('.post-subtitle')!.textContent = post.subtitle ? truncate(post.subtitle, 160) : truncate(post.body, 160);

        gridEl.appendChild(node);
      }
    }
  }

  loadFeed<TweebleBlogPost[]>(TWEEBLE.api.blog, render).catch((err) => {
    loadingEl?.remove();
    errorEl?.classList.remove('hidden');
    console.error('Failed to load Tweeble blog posts', err);
  });
</script>
