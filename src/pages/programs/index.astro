---
import { TWEEBLE } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProgramGrid from '../../components/ProgramGrid.astro';
import { getProgramUrlMap } from '../../lib/programs';
import danceHero from '../../assets/photos/dance-classes.png';

const urlMap = await getProgramUrlMap();
---

<BaseLayout feeds={[TWEEBLE.api.programs]} title="Programs & Classes" description="Ongoing classes and programs at Shri Shiv Dham Hindu Temple, live from the Temple Hub.">
  <PageHero
    eyebrow="Learn"
    title="Programs &amp; Classes"
    description="Classes and camps for children and adults, live from the Temple Hub. Choose a program to see the details and register."
    image={danceHero}
    imageAlt="Kalagangothri classical dance students at the temple"
    focus="top"
  />

  <div class="container-page py-16 sm:py-20">
    <ProgramGrid urlMap={urlMap} />

    <div class="mt-16 rounded-2xl bg-ivory-100 p-8 text-center">
      <p class="text-ivory-700">
        Have a question about a class, or looking for something not listed?
        <a href="/contact-us/" class="font-semibold text-maroon-700 underline decoration-marigold-300 decoration-2 underline-offset-2">Contact the temple office</a>.
      </p>
    </div>
  </div>
</BaseLayout>
