---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You" description="Thank you for your donation.">
  <div class="container-page flex min-h-[50vh] flex-col items-center justify-center py-20 text-center">
    <div class="flex h-16 w-16 items-center justify-center rounded-full bg-tulsi-100 text-3xl text-tulsi-700">✓</div>
    <h1 class="mt-6 text-4xl">Thank You for Your Gift</h1>
    <p class="mt-4 max-w-md text-lg text-ivory-600">
      Your donation has been received. A confirmation has been sent to your email. Your generosity helps sustain worship, festivals, and community programs at Shri Shiv Dham.
    </p>
    <a href="/" class="btn-primary mt-8">Return Home</a>
  </div>
</BaseLayout>
