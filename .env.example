# Copy this file to .env for local development (netlify dev reads it),
# and set the same variables in the Netlify dashboard for production:
# Site configuration -> Environment variables.
#
# Contact forms, feedback, summer-camp registration, volunteer sign-up, and
# donations all go through the temple's Tweeble account directly from the
# browser, so they need no keys here.

# --- Stripe (Temple Store checkout only) ---
# Not live yet — the temple's Stripe account doesn't exist as of this
# writing. Fill these in once it does; no code changes are needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
