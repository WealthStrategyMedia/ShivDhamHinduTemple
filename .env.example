# Copy this file to .env for local development (netlify dev reads it),
# and set the same variables in the Netlify dashboard for production:
# Site settings -> Environment variables.

# --- Resend (contact form + donation receipt emails) ---
# Get a free key at https://resend.com — free tier covers 3,000 emails/month.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@shivatempleorlando.org
CONTACT_FROM_EMAIL="Shiv Dham Website <onboarding@resend.dev>"

# --- Stripe (donations + puja/product checkout) ---
# Not live yet — the temple's Stripe account doesn't exist as of this
# writing. Fill these in once it does; no code changes are needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
